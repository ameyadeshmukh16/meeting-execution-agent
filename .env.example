# LLM: openrouter (default), anthropic, or ollama (local; set OLLAMA_MODEL, e.g. qwen3:8b)
# Each provider+model gets its own replay-cache file, so switching never replays another model's answers.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Replay cache: fallback (default, replay only if the LLM fails) | prefer (cache first, for the demo) | off
LLM_CACHE=fallback

# Trello
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=
