# LLM: openrouter (default) or anthropic
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Replay cache: fallback (default, replay only if the LLM fails) | prefer (cache first, for the demo) | off
LLM_CACHE=fallback

# Trello
TRELLO_KEY=
TRELLO_TOKEN=
TRELLO_LIST_ID=
